<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
    Section: properties details
    -->
    <groupId>com.github.livreprogramacao.example</groupId>
    <artifactId>junit-recipes</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Java unit test: warehouse stock simulation (arrays)</name>
    <description>
        Below is a concise JUnit 5 test class that uses arrays to simulate warehouse stock levels and operations
        (receive, ship, transfer, check).
        It includes setup, several operation methods operating directly on arrays, and tests that exercise normal and
        edge cases.
    </description>
    <url>https://github.com/livreprogramacao/junit-recipes</url>
    <licenses>
        <!--
        Section: licenses details
